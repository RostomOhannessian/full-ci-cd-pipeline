<Project>

  <!-- Central Package Management. Every version lives here, and a project names a package without a version. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin transitive packages to the version chosen here, so a vulnerable transitive version cannot come back unnoticed. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Test stack (ADR-0018). Versions were checked on 2026-10-08 and exercised in spike 1.c. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
  </ItemGroup>

  <!-- Governance.Auditor (ADR-0021). Both packages are MIT licensed with no dependencies on net10.0. Versions were checked on 2026-10-08. -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Catalog.Contract.Tests (ADR-0027). Both packages are MIT licensed. They stay on the 2.x line, because Microsoft.AspNetCore.OpenApi 10.0
       depends on Microsoft.OpenApi 2.x, and the conformance check will compare documents that this library wrote. Versions were checked on 2026-10-11. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="2.12.2" />
  </ItemGroup>

  <!-- Catalog.Domain.Tests (ADR-0018, ADR-0029). AwesomeAssertions and CsCheck are Apache-2.0 and Microsoft.Extensions.TimeProvider.Testing is MIT, and
       none has a dependency on net10.0. The versions of the first two are the ones of plan section 17, and all three were checked on 2026-10-11. -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <!-- Catalog.CrossCutting (ADR-0032). FluentValidation is Apache-2.0 and has no dependency on net8.0 or later. The version is the one of plan section 17. 12.2.0 was released on
       2026-10-10, and this ADR keeps the planned version until Dependabot proposes the update. Checked on 2026-11-01. -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <!-- Catalog.Infrastructure (ADR-0033). EF Core and its design-time package are MIT licensed, and so is Microsoft.Data.SqlClient. EF Core 10.0.14 depends on SqlClient 6.1.7, and the
       pin below raises it to 7.1.1, the version of plan section 17 that spikes 1.d and 1.e ran (transitive pinning makes the pin win). SqlClient 7.1.1 depends on
       System.Security.Cryptography.Pkcs 9.0.18, which has two published advisories (GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx, patched in 9.0.21 and 10.0.13), so the pin lifts it to 10.0.14,
       the version that ships with the runtime of this solution (ADR-0020). Versions were checked on 2026-11-01. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <!-- Catalog caching (ADR-0016, ADR-0038). Every package is MIT licensed (the license expression of each nuspec, checked 2026-11-03), and 2.9.0 is the newest FusionCache (checked 2026-11-03), which is the version of
       plan section 17 that spike 1.b ran. CrossCutting holds FusionCache and its System.Text.Json serializer. Infrastructure holds the connection to Valkey: the distributed cache and the backplane, both over
       StackExchange.Redis. The backplane package depends on StackExchange.Redis 2.10.1 and the distributed cache package on 2.7.27, so the pin below makes the version that the spike ran the one that every
       project resolves. 3.x of StackExchange.Redis exists (checked 2026-11-03), and the repository stays on the 2.x line until FusionCache's backplane package supports it. -->
  <ItemGroup>
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageVersion Include="StackExchange.Redis" Version="2.10.1" />
  </ItemGroup>

  <!-- Catalog.Infrastructure.Tests (ADR-0034). Testcontainers is MIT licensed. 4.16.0 exists (checked 2026-11-01), and the repository keeps the 4.15.0 of plan section 17 that spike 1.d ran
       until Dependabot proposes the update. -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
  </ItemGroup>

  <!-- Catalog.Api and the health checks (WP1.10, ADR-0040). Both packages are MIT licensed (the license expression of each nuspec, checked 2026-11-03). 10.0.14 is the newest 10.0 patch (checked 2026-11-03), and it is the
       version of the EF Core and hosting packages above, so the whole solution runs one patch of the 10.0 line. JwtBearer depends on Microsoft.IdentityModel.Protocols.OpenIdConnect 8.19.2 (MIT). The health check
       abstractions are a package of their own, so Infrastructure and CrossCutting can implement a check without a reference to ASP.NET Core. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <!-- Catalog.Api (WP1.10, ADR-0041). Asp.Versioning.Http routes the version segment of the path and reports the supported and deprecated versions of each response. It is MIT licensed (the license expression
       of its nuspec, checked 2026-11-04), 10.2.3 is its newest release (checked 2026-11-04), and its one dependency on net10.0 is Asp.Versioning.Abstractions, which is MIT licensed too. -->
  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
  </ItemGroup>

  <!-- Catalog.Api (WP1.10, ADR-0042). Scalar.AspNetCore serves the dev-only viewer of the contract. It is MIT licensed (the license expression of its nuspec, checked 2026-11-04), 2.18.7 is its newest release (checked 2026-11-04),
       and it has no dependency on net10.0 besides the shared framework of ASP.NET Core. -->
  <ItemGroup>
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
  </ItemGroup>

  <!-- Catalog.Api (WP1.11, ADR-0043). OpenTelemetry .NET is Apache-2.0 licensed (the license expression of each nuspec, checked 2026-11-04). 1.20.1 is the newest stable release of the SDK, the exporter, the hosting
       package, and the instrumentation of ASP.NET Core, HttpClient, SqlClient, and the runtime (checked 2026-11-04). The instrumentation of EF Core and of StackExchange.Redis has never had a stable release, so both are
       pinned to the exact beta that matches the SDK (1.20.1-beta.1), and a change of either version needs a review of its release notes (ADR-0043). Microsoft.Extensions.Compliance.Redaction is MIT licensed, and
       10.11.0 is its newest release (checked 2026-11-04). The in-memory exporter of the tests is part of the same family and is pinned with it. -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.20.1-beta.1" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
  </ItemGroup>

  <!-- Catalog.Api.Tests (WP1.10, ADR-0040). The test host of ASP.NET Core is MIT licensed (checked 2026-11-03), and it starts the real composition root in process. The snapshots of the API tests are
       compared by a helper in the test project and not by Verify, because Verify.XunitV3 from 33.0.0 fails the build unless the owner declares a sponsorship or an exemption (ADR-0042, checked 2026-11-04). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

</Project>

# Local environment for compose.yaml (the API-only stack). `dev bootstrap` copies this file to .env and fills in every variable that has no value
# here with a random secret. Git ignores .env, and secrets are never copied from one machine to another.
#
# This file holds variable names and safe local defaults only. A variable with a value is a default, and a variable with no value is a
# secret that `dev bootstrap` generates. Never put a real credential in this file.

# Ports on 127.0.0.1. They are high ports, so no administrator rights are needed, and the stack is not reachable from the network.
# Change a port here if another program uses it, and `dev doctor` tells you which ones are taken. The API will use 8080, and its
# management port will use 8081. Keycloak advertises http://localhost:<KEYCLOAK_PORT>/realms/catalog as its issuer.
SQL_PORT=1433
VALKEY_PORT=6379
KEYCLOAK_PORT=8180
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# SQL Server. The `sa` login is a local convenience for the stack, and Phase 3 replaces it with Vault-managed logins.
MSSQL_SA_PASSWORD=

# Valkey. The default user is switched off. `admin` runs health checks and operations, and the application user can touch only the
# catalog development keys and channels (see the ACL in compose.yaml).
VALKEY_ADMIN_PASSWORD=
VALKEY_APP_USER=catalog-dev
VALKEY_APP_PASSWORD=

# Keycloak. The first administrator, and the secrets and demo passwords that identity/keycloak/realms/catalog-realm.json reads as ${NAME}.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
CATALOG_SMOKE_TESTS_SECRET=
CATALOG_SYNTHETIC_SHOPPER_SECRET=
CATALOG_READER_PASSWORD=
CATALOG_EDITOR_PASSWORD=
CATALOG_ADMIN_PASSWORD=

# Grafana, in the grafana/otel-lgtm container.
GRAFANA_ADMIN_PASSWORD=

Set-StrictMode -Version Latest

# The local environment file. `.env.example` lists every variable that compose.yaml reads. A variable with a value there is a safe local
# default, and a variable with no value is a secret, so `dev bootstrap` generates a random one into `.env`, which Git ignores. Nothing
# is ever copied from another machine: a new machine gets new secrets (plan section 6).

Import-Module (Join-Path $PSScriptRoot 'Dev.Common.psm1')

function Read-DevEnvFile {
    <#
    .SYNOPSIS
        Reads KEY=VALUE lines into an ordered dictionary. Comments and blank lines are skipped, and a value is taken as written.
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)] [string] $Path)

    $values = [ordered]@{}
    if (-not (Test-Path -Path $Path -PathType Leaf)) { return $values }

    $number = 0
    foreach ($line in (Get-Content -Path $Path)) {
        $number++
        if ($line -match '^\s*(#.*)?$') { continue }
        $match = [regex]::Match($line, '^(?<key>[A-Z][A-Z0-9_]*)=(?<value>.*)$')
        if (-not $match.Success) { throw "${Path}:${number}: expected NAME=value, and found a line that is not one." }
        $values[$match.Groups['key'].Value] = $match.Groups['value'].Value
    }

    return $values
}

function Get-DevSecret {
    <#
    .SYNOPSIS
        Returns a random secret of letters and digits that is safe in a URL, a shell, an ACL file, and a SQL Server password.
    .DESCRIPTION
        It uses the operating system's cryptographic generator and always includes an upper case letter, a lower case letter, and a digit,
        which meets the SQL Server password policy. It avoids symbols, so no consumer has to quote it.
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param([ValidateRange(16, 128)] [int] $Length = 32)

    $upper = 'ABCDEFGHJKLMNPQRSTUVWXYZ'
    $lower = 'abcdefghijkmnopqrstuvwxyz'
    $digits = '23456789'
    $all = $upper + $lower + $digits

    do {
        $chars = foreach ($i in 1..$Length) { $all[[System.Security.Cryptography.RandomNumberGenerator]::GetInt32($all.Length)] }
        $secret = -join $chars
    } until ($secret -cmatch '[A-Z]' -and $secret -cmatch '[a-z]' -and $secret -match '[2-9]')

    return $secret
}

function Initialize-DevEnvironment {
    <#
    .SYNOPSIS
        Creates .env from .env.example, or adds the variables that .env lacks, and returns what it did.
    .DESCRIPTION
        An existing value is never changed unless -Force is given. With -Force, every variable that .env.example leaves empty gets a new
        secret, and the caller must reset the Compose volumes, because a database keeps the password it was first created with.
    #>
    [CmdletBinding()]
    param(
        [string] $TemplatePath = (Join-Path (Get-DevRepositoryRoot) '.env.example'),
        [string] $Path = (Join-Path (Get-DevRepositoryRoot) '.env'),
        [switch] $Force
    )

    if (-not (Test-Path -Path $TemplatePath -PathType Leaf)) { throw "The template '$TemplatePath' does not exist." }

    $template = Read-DevEnvFile -Path $TemplatePath
    $existing = Read-DevEnvFile -Path $Path
    $created = -not (Test-Path -Path $Path -PathType Leaf)
    $generated = [System.Collections.Generic.List[string]]::new()
    $defaulted = [System.Collections.Generic.List[string]]::new()
    $lines = [System.Collections.Generic.List[string]]::new()

    if ($created) {
        $lines.Add('# Local environment for compose.yaml, generated by "dev bootstrap" from .env.example. Git ignores this file.')
        $lines.Add('# Every secret below is random and belongs to this machine only. Never copy it to another machine or commit it.')
    }
    else {
        $lines.AddRange([string[]](Get-Content -Path $Path))
    }

    $updated = [ordered]@{}
    foreach ($key in $template.Keys) {
        $needsSecret = [string]::IsNullOrEmpty($template[$key])
        $hasValue = $existing.Contains($key) -and -not [string]::IsNullOrEmpty($existing[$key])

        if ($hasValue -and -not ($Force -and $needsSecret)) { continue }

        $value = if ($needsSecret) { Get-DevSecret } else { $template[$key] }
        if ($needsSecret) { $generated.Add($key) } else { $defaulted.Add($key) }

        if ($existing.Contains($key)) {
            for ($index = 0; $index -lt $lines.Count; $index++) {
                if ($lines[$index] -match "^$([regex]::Escape($key))=") {
                    $lines[$index] = "$key=$value"
                    break
                }
            }
        }
        else {
            $lines.Add("$key=$value")
        }
        $updated[$key] = $value
    }

    if ($created -or $updated.Count -gt 0) {
        $text = ($lines -join "`n") + "`n"
        [System.IO.File]::WriteAllText($Path, $text, [System.Text.UTF8Encoding]::new($false))
        if (-not $IsWindows) { [System.IO.File]::SetUnixFileMode($Path, [System.IO.UnixFileMode]'UserRead, UserWrite') }
    }

    return [pscustomobject]@{
        Path      = $Path
        Created   = $created
        Generated = $generated.ToArray()
        Defaulted = $defaulted.ToArray()
        Changed   = $updated.Count -gt 0
    }
}

function Test-DevEnvironment {
    <#
    .SYNOPSIS
        Compares .env with .env.example and returns the variables that .env lacks or leaves empty.
    #>
    [CmdletBinding()]
    param(
        [string] $TemplatePath = (Join-Path (Get-DevRepositoryRoot) '.env.example'),
        [string] $Path = (Join-Path (Get-DevRepositoryRoot) '.env')
    )

    $template = Read-DevEnvFile -Path $TemplatePath
    $existing = Read-DevEnvFile -Path $Path
    $missing = @($template.Keys | Where-Object { -not $existing.Contains($_) -or [string]::IsNullOrEmpty($existing[$_]) })

    return [pscustomobject]@{ Exists = (Test-Path -Path $Path -PathType Leaf); Missing = $missing }
}

Export-ModuleMember -Function Read-DevEnvFile, Get-DevSecret, Initialize-DevEnvironment, Test-DevEnvironment

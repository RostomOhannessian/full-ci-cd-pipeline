<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Dependency intake controls (ADR-0020). Every package comes from nuget.org, only through the mapping below,
    and only if it carries a repository signature from a certificate listed under trustedSigners.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping stops a package from being resolved from a source it is not mapped to. With one source the mapping is
    a single pattern. When a second source is ever added, give it explicit package ID patterns and keep this one broad.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <!--
    The nuget.org repository signing certificates, copied from the service's own endpoint
    https://api.nuget.org/v3-index/repository-signatures/5.0.0/index.json (checked 2026-10-08).
    The current certificate expires on 2027-05-18. Before then, re-read the endpoint and add any new fingerprint.
  -->
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>

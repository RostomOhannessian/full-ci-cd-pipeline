{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements register",
  "description": "Schema for docs/requirements/requirements.yaml. Every requirement has a stable REQ-<AREA>-<NNN> ID, the work packages that deliver it, and the kinds of verification that prove it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "last-verified", "areas", "requirements"],
  "properties": {
    "schema-version": { "const": 1 },
    "last-verified": { "$ref": "#/$defs/date" },
    "areas": {
      "description": "One entry per area code, with a plain-language name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/area" },
      "additionalProperties": { "type": "string", "minLength": 3 },
      "minProperties": 21
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "area": { "enum": ["ARC", "DOM", "APP", "API", "DATA", "CACHE", "SEC", "IDN", "OBS", "QUA", "CI", "SUP", "INF", "NET", "POL", "GIT", "CON", "DOC", "DX", "GOV", "AI"] },
    "workPackage": { "type": "string", "pattern": "^(WP\\d+\\.\\d+|LAUNCH)$" },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "statement", "source", "delivered-by", "verification", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-(ARC|DOM|APP|API|DATA|CACHE|SEC|IDN|OBS|QUA|CI|SUP|INF|NET|POL|GIT|CON|DOC|DX|GOV|AI)-\\d{3}$" },
        "title": { "type": "string", "minLength": 5, "maxLength": 100 },
        "statement": {
          "description": "One testable sentence that says what must be true.",
          "type": "string",
          "minLength": 20
        },
        "source": {
          "description": "Where the requirement comes from: the original brief, the documentation request, the planning request, a decision made during the plan review, or the plan itself.",
          "enum": ["brief", "docs-request", "planning-request", "review", "plan"]
        },
        "brief-rows": {
          "description": "Row numbers of the brief traceability table in plan section 2.1 that this requirement helps satisfy.",
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 38 },
          "uniqueItems": true
        },
        "delivered-by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/workPackage" }
        },
        "verification": {
          "description": "The kinds of test or evidence that prove the requirement, using the suite names in plan section 10.1.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["unit", "architecture", "snapshot", "integration", "contract", "property", "e2e", "policy", "iac", "scan", "ci", "performance", "script", "docs", "drill", "manual"]
          }
        },
        "evidence": {
          "description": "What a reviewer looks at to confirm it, for example a report, a workflow run, or a transcript.",
          "type": "string"
        },
        "status": { "enum": ["planned", "in_progress", "verified", "deferred", "withdrawn"] },
        "notes": { "type": "string" }
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">

  <!-- CrossCutting implements handler decorators and observability over Application, and never references Infrastructure (plan section 8.1). -->

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
  </ItemGroup>

  <!-- The validation decorator and the validators use FluentValidation, which the Application layer may not reference (ADR-0032). -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <!-- The cache adapter uses FusionCache over the abstract distributed cache and backplane that Infrastructure builds (plan section 8.1, ADR-0038). -->
  <ItemGroup>
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
  </ItemGroup>

</Project>

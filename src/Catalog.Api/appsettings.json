{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Catalog": {
    "Hosting": {
      "ListenAddress": "127.0.0.1",
      "PublicPort": 8080,
      "ManagementPort": 8081
    },
    "Auth": {
      "Audience": "catalog-api",
      "RequireHttpsMetadata": true
    },
    "Cache": {
      "Environment": "dev"
    }
  }
}

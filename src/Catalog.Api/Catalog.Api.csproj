<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Api is the composition root. It owns all dependency registration and contains no business logic (plan section 8.1, ADR-0040). -->

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\Catalog.CrossCutting\Catalog.CrossCutting.csproj" />
    <ProjectReference Include="..\Catalog.Contracts\Catalog.Contracts.csproj" />
  </ItemGroup>

  <!-- JWT bearer authentication (REQ-IDN-003). The package is MIT licensed, and the validation settings are in Security/ConfigureJwtBearer.cs. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <!-- The integration tests read the internal types of the host, such as the options validators and the claims reader, and the contract tests compare the error table of the API with the catalog. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Catalog.Api.Tests" />
    <InternalsVisibleTo Include="Catalog.Contract.Tests" />
  </ItemGroup>

</Project>

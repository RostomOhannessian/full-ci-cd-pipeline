<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure implements the ports that Application defines, and references Application only (plan section 8.1). It owns the persistence of the catalog (EF Core on SQL Server),
       the transactional outbox, the idempotency store, and the sources of database credentials (WP1.8, ADR-0033), and the connection to Valkey (WP1.9, ADR-0038). -->

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <!-- The connection to Valkey: the distributed cache and the backplane that the FusionCache adapter of CrossCutting uses (WP1.9, ADR-0038). Infrastructure builds them and never names FusionCache itself. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <!-- The design-time package is for the dotnet-ef tool only (migrations, the bundle, and the idempotent script), so it never reaches a consumer of this project. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

</Project>
